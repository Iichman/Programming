<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Contacts"
        Height="350" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontSize="12">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>


        <GroupBox Header="Edit contact" 
                  Grid.Row="0"
                  Grid.Column="0" 
                  Padding="10"
                  Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Name:" Margin="0,0,0,3"/>
                <TextBox x:Name="NameInput" 
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="25" 
                         Margin="0,0,0,3" 
                         Padding="3"/>

                <TextBlock Text="Phone Number:" Margin="0,0,0,3"/>
                <TextBox x:Name="PhoneInput" 
                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="25" 
                         Margin="0,0,0,3" 
                         Padding="3"/>

                <TextBlock Text="Email:" Margin="0,0,0,3"/>
                <TextBox x:Name="EmailInput" 
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="25" 
                         Margin="0,0,0,0" 
                         Padding="3"/>
            </StackPanel>
        </GroupBox>


        <GroupBox Header="Read contact" 
                  Grid.Row="0"
                  Grid.Column="2" 
                  Padding="10"
                  Margin="10,0,0,0">
            <StackPanel>
                <TextBlock Text="Name:" Margin="0,0,0,3"/>
                <TextBlock x:Name="NameDisplay" 
                           Text="{Binding Name}"
                           Height="25" 
                           Margin="0,0,0,3" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Phone Number:" Margin="0,0,0,3"/>
                <TextBlock x:Name="PhoneDisplay" 
                           Text="{Binding PhoneNumber}"
                           Height="25" 
                           Margin="0,0,0,3" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Email:" Margin="0,0,0,3"/>
                <TextBlock x:Name="EmailDisplay" 
                           Text="{Binding Email}"
                           Height="25" 
                           Margin="0,0,0,0" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>


        <StackPanel Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}"
                    Width="75" 
                    Height="25" 
                    Margin="0,0,3,0"
                    FontWeight="Bold"/>
            <Button Content="Load" 
                    Command="{Binding LoadCommand}"
                    Width="75" 
                    Height="25"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>